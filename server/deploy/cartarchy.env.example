# Installed as ~/_services/cartarchy/cartarchy.env (mode 600) on the deploy host.
# deploy.sh creates it on first install with random secrets and never overwrites it.

# Only nginx reaches the server; frpc and nginx terminate the public traffic.
CARTARCHY_LISTEN=127.0.0.1:18080
CARTARCHY_PUBLIC_URL=https://cartarchy.diller.org
CARTARCHY_DATA=/home/dillera/_services/cartarchy/data/cartarchy.sqlite

# Fixed so pairing QR codes stay valid across restarts.
CARTARCHY_PAIRING_CODE=change-me

CARTARCHY_ADMIN_USERNAME=admin
CARTARCHY_ADMIN_PASSWORD=change-me
